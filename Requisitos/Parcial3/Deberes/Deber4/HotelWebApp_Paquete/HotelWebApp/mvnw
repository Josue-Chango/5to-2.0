# ----------------------------------------------------------------------------
# Maven Start Up Batch script
#
# Required ENV vars:
# ------------------
#   JAVA_HOME - location of a JDK home dir
#
# Optional ENV vars
# -----------------
#   M2_HOME - location of maven2's installed home dir
#   MAVEN_OPTS - parameters passed to the Java VM when running Maven
#     e.g. to debug Maven itself, use
#       set MAVEN_OPTS=-Xdebug -Xrunjdwp:transport=dt_socket,server=y,suspend=y,address=8000
#   MAVEN_SKIP_RC - flag to disable loading of mavenrc files
# ----------------------------------------------------------------------------

if [ -z "$JAVA_HOME" ] ; then
  echo "JAVA_HOME not set. Please set JAVA_HOME to your JDK installation directory."
  exit 1
fi

if [ ! -x "$JAVA_HOME/bin/java" ] ; then
  echo "JAVA_HOME is set to an invalid directory: $JAVA_HOME"
  exit 1
fi

# Determine Maven Wrapper jar
MW_JAR="$HOME/.m2/wrapper/maven-wrapper.jar"
if [ ! -f "$MW_JAR" ] ; then
  echo "Downloading Maven Wrapper jar..."
  MW_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
  mkdir -p "$HOME/.m2/wrapper"
  if command -v curl > /dev/null 2>&1 ; then
    curl -sS -o "$MW_JAR" "$MW_URL"
  elif command -v wget > /dev/null 2>&1 ; then
    wget -q -O "$MW_JAR" "$MW_URL"
  else
    echo "Neither curl nor wget found. Please install one of them or manually download the Maven Wrapper jar."
    exit 1
  fi
  if [ ! -f "$MW_JAR" ] ; then
    echo "Failed to download Maven Wrapper jar."
    exit 1
  fi
fi

exec "$JAVA_HOME/bin/java" $MAVEN_OPTS \
  -classpath "$MW_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$(pwd)" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"

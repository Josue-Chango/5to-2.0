<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bizagi.com/definitions">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_1" name="Proceso de Estudio de Caso" processRef="Process_CaseStudy"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CaseStudy" name="Proceso de Estudio de Caso" isExecutable="false">

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Fase 1: Diseño">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Fase 2: Preparación">
        <bpmn:flowNodeRef>Task_2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Signal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Fase 3: Recolección">
        <bpmn:flowNodeRef>Task_3_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Fase 4: Análisis">
        <bpmn:flowNodeRef>Task_4_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="Fase 5: Reporte">
        <bpmn:flowNodeRef>Start_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- FASE 1: DISEÑO -->
    <bpmn:startEvent id="Start_1" name="Inicio">
      <bpmn:outgoing>sf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_1_1" name="Definir objetivo y preguntas">
      <bpmn:incoming>sf1</bpmn:incoming>
      <bpmn:outgoing>sf2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_1_2" name="Formular proposiciones">
      <bpmn:incoming>sf2</bpmn:incoming>
      <bpmn:outgoing>sf3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_1_3" name="Seleccionar el caso y unidad de análisis">
      <bpmn:incoming>sf3</bpmn:incoming>
      <bpmn:outgoing>sf4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObject id="DataObject_1_o"/>
    <bpmn:dataObjectReference id="DataObject_1" name="Descripción del Caso" dataObjectRef="DataObject_1_o"/>

    <!-- FASE 2: PREPARACIÓN -->
    <bpmn:task id="Task_2_1" name="Diseñar el protocolo de investigación">
      <bpmn:incoming>sf4</bpmn:incoming>
      <bpmn:outgoing>sf5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObject id="DataObject_2_o"/>
    <bpmn:dataObjectReference id="DataObject_2" name="Protocolo de Investigación" dataObjectRef="DataObject_2_o"/>
    <bpmn:task id="Task_2_2" name="Gestionar acceso con la empresa/equipo">
      <bpmn:incoming>sf5</bpmn:incoming>
      <bpmn:outgoing>sf6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_2_3" name="Garantizar ética y confidencialidad">
      <bpmn:incoming>sf6</bpmn:incoming>
      <bpmn:outgoing>sf7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObject id="DataObject_3_o"/>
    <bpmn:dataObjectReference id="DataObject_3" name="Formularios de Consentimiento, Acuerdos NDA" dataObjectRef="DataObject_3_o"/>
    <bpmn:intermediateThrowEvent id="Event_Signal" name="Señal de límite (negociación exitosa)">
      <bpmn:incoming>sf7</bpmn:incoming>
      <bpmn:outgoing>sf8</bpmn:outgoing>
      <bpmn:signalEventDefinition/>
    </bpmn:intermediateThrowEvent>

    <!-- FASE 3: RECOLECCIÓN -->
    <bpmn:dataObject id="DataObject_4_o"/>
    <bpmn:dataObjectReference id="DataObject_4" name="Artefacto (micrófono, notas)" dataObjectRef="DataObject_4_o"/>
    <bpmn:task id="Task_3_1" name="Ejecutar instrumentos de recolección (entrevistas, observación, revisión documental)">
      <bpmn:incoming>sf8</bpmn:incoming>
      <bpmn:incoming>sf12</bpmn:incoming>
      <bpmn:outgoing>sf9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_3_2" name="Registrar evidencia (grabaciones, notas de campo)">
      <bpmn:incoming>sf9</bpmn:incoming>
      <bpmn:outgoing>sf10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_3_3" name="Triangular datos (datos, metodologías, investigadores, teoría)">
      <bpmn:incoming>sf10</bpmn:incoming>
      <bpmn:outgoing>sf11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_1" name="¿Saturación alcanzada?">
      <bpmn:incoming>sf11</bpmn:incoming>
      <bpmn:outgoing>sf12</bpmn:outgoing>
      <bpmn:outgoing>sf13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:textAnnotation id="TextAnnotation_1">
      <bpmn:text>El rastro de auditoría y la verificación con participantes son cruciales</bpmn:text>
    </bpmn:textAnnotation>

    <!-- FASE 4: ANÁLISIS -->
    <bpmn:task id="Task_4_1" name="Codificar datos cualitativos (Abierta, Axial, Selectiva)">
      <bpmn:incoming>sf13</bpmn:incoming>
      <bpmn:incoming>sf16</bpmn:incoming>
      <bpmn:outgoing>sf14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_4_2" name="Construir cadena de evidencia (Rastro de auditoría)">
      <bpmn:incoming>sf14</bpmn:incoming>
      <bpmn:outgoing>sf15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObject id="DataObject_5_o"/>
    <bpmn:dataObjectReference id="DataObject_5" name="Registro de Auditoría" dataObjectRef="DataObject_5_o"/>
    <bpmn:task id="Task_4_3" name="Realizar análisis intra-caso / entre-casos">
      <bpmn:incoming>sf15</bpmn:incoming>
      <bpmn:outgoing>sf16</bpmn:outgoing>
      <bpmn:outgoing>sf17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_4_4" name="Verificación con participantes (validar interpretación)">
      <bpmn:incoming>sf17</bpmn:incoming>
      <bpmn:outgoing>sf18</bpmn:outgoing>
    </bpmn:task>

    <!-- FASE 5: REPORTE -->
    <bpmn:startEvent id="Start_2" name="Mensaje de inicio de texto">
      <bpmn:outgoing>sf19</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:task id="Task_5_1" name="Estructurar el documento (IMRaD)">
      <bpmn:incoming>sf18</bpmn:incoming>
      <bpmn:incoming>sf19</bpmn:incoming>
      <bpmn:outgoing>sf20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObject id="DataObject_6_o"/>
    <bpmn:dataObjectReference id="DataObject_6" name="Formato adaptado" dataObjectRef="DataObject_6_o"/>
    <bpmn:task id="Task_5_2" name="Discutir hallazgos (vs. literatura)">
      <bpmn:incoming>sf20</bpmn:incoming>
      <bpmn:outgoing>sf21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_5_3" name="Evaluar validez (amenazas y mitigaciones)">
      <bpmn:incoming>sf21</bpmn:incoming>
      <bpmn:outgoing>sf22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObject id="DataObject_7_o"/>
    <bpmn:dataObjectReference id="DataObject_7" name="Informe de Validez" dataObjectRef="DataObject_7_o"/>
    <bpmn:task id="Task_5_4" name="Definir límites de generalización">
      <bpmn:incoming>sf22</bpmn:incoming>
      <bpmn:outgoing>sf23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObject id="DataObject_8_o"/>
    <bpmn:dataObjectReference id="DataObject_8" name="Mapa de Generalización" dataObjectRef="DataObject_8_o"/>
    <bpmn:task id="Task_5_5" name="Publicar Estudio de Caso">
      <bpmn:incoming>sf23</bpmn:incoming>
      <bpmn:outgoing>sf24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_1" name="Fin">
      <bpmn:incoming>sf24</bpmn:incoming>
    </bpmn:endEvent>

    <!-- SECUENCIAS -->
    <bpmn:sequenceFlow id="sf1" sourceRef="Start_1" targetRef="Task_1_1"/>
    <bpmn:sequenceFlow id="sf2" sourceRef="Task_1_1" targetRef="Task_1_2"/>
    <bpmn:sequenceFlow id="sf3" sourceRef="Task_1_2" targetRef="Task_1_3"/>
    <bpmn:sequenceFlow id="sf4" sourceRef="Task_1_3" targetRef="Task_2_1"/>
    <bpmn:sequenceFlow id="sf5" sourceRef="Task_2_1" targetRef="Task_2_2"/>
    <bpmn:sequenceFlow id="sf6" sourceRef="Task_2_2" targetRef="Task_2_3"/>
    <bpmn:sequenceFlow id="sf7" sourceRef="Task_2_3" targetRef="Event_Signal"/>
    <bpmn:sequenceFlow id="sf8" sourceRef="Event_Signal" targetRef="Task_3_1"/>
    <bpmn:sequenceFlow id="sf9" sourceRef="Task_3_1" targetRef="Task_3_2"/>
    <bpmn:sequenceFlow id="sf10" sourceRef="Task_3_2" targetRef="Task_3_3"/>
    <bpmn:sequenceFlow id="sf11" sourceRef="Task_3_3" targetRef="Gateway_1"/>
    <bpmn:sequenceFlow id="sf12" name="No" sourceRef="Gateway_1" targetRef="Task_3_1"/>
    <bpmn:sequenceFlow id="sf13" name="Sí" sourceRef="Gateway_1" targetRef="Task_4_1"/>
    <bpmn:sequenceFlow id="sf14" sourceRef="Task_4_1" targetRef="Task_4_2"/>
    <bpmn:sequenceFlow id="sf15" sourceRef="Task_4_2" targetRef="Task_4_3"/>
    <bpmn:sequenceFlow id="sf16" name="Revisar codificación" sourceRef="Task_4_3" targetRef="Task_4_1"/>
    <bpmn:sequenceFlow id="sf17" sourceRef="Task_4_3" targetRef="Task_4_4"/>
    <bpmn:sequenceFlow id="sf18" sourceRef="Task_4_4" targetRef="Task_5_1"/>
    <bpmn:sequenceFlow id="sf19" sourceRef="Start_2" targetRef="Task_5_1"/>
    <bpmn:sequenceFlow id="sf20" sourceRef="Task_5_1" targetRef="Task_5_2"/>
    <bpmn:sequenceFlow id="sf21" sourceRef="Task_5_2" targetRef="Task_5_3"/>
    <bpmn:sequenceFlow id="sf22" sourceRef="Task_5_3" targetRef="Task_5_4"/>
    <bpmn:sequenceFlow id="sf23" sourceRef="Task_5_4" targetRef="Task_5_5"/>
    <bpmn:sequenceFlow id="sf24" sourceRef="Task_5_5" targetRef="End_1"/>

    <!-- ASOCIACIONES CON OBJETOS DE DATOS Y ANOTACIÓN -->
    <bpmn:association id="assoc1" sourceRef="Task_1_3" targetRef="DataObject_1"/>
    <bpmn:association id="assoc2" sourceRef="Task_2_1" targetRef="DataObject_2"/>
    <bpmn:association id="assoc3" sourceRef="Task_2_3" targetRef="DataObject_3"/>
    <bpmn:association id="assoc4" sourceRef="DataObject_4" targetRef="Task_3_1"/>
    <bpmn:association id="assoc5" sourceRef="Gateway_1" targetRef="TextAnnotation_1"/>
    <bpmn:association id="assoc6" sourceRef="Task_4_2" targetRef="DataObject_5"/>
    <bpmn:association id="assoc7" sourceRef="Task_5_1" targetRef="DataObject_6"/>
    <bpmn:association id="assoc8" sourceRef="Task_5_3" targetRef="DataObject_7"/>
    <bpmn:association id="assoc9" sourceRef="Task_5_4" targetRef="DataObject_8"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Pool_1_di" bpmnElement="Pool_1" isHorizontal="true">
        <omgdc:Bounds x="0" y="0" width="1400" height="800"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <omgdc:Bounds x="40" y="0" width="1360" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <omgdc:Bounds x="40" y="160" width="1360" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true">
        <omgdc:Bounds x="40" y="320" width="1360" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_4_di" bpmnElement="Lane_4" isHorizontal="true">
        <omgdc:Bounds x="40" y="480" width="1360" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_5_di" bpmnElement="Lane_5" isHorizontal="true">
        <omgdc:Bounds x="40" y="640" width="1360" height="160"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <omgdc:Bounds x="132" y="62" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_1_di" bpmnElement="Task_1_1">
        <omgdc:Bounds x="210" y="55" width="130" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_2_di" bpmnElement="Task_1_2">
        <omgdc:Bounds x="380" y="55" width="130" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_3_di" bpmnElement="Task_1_3">
        <omgdc:Bounds x="550" y="55" width="150" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObject_1_di" bpmnElement="DataObject_1">
        <omgdc:Bounds x="700" y="60" width="36" height="40"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_2_1_di" bpmnElement="Task_2_1">
        <omgdc:Bounds x="330" y="190" width="150" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObject_2_di" bpmnElement="DataObject_2">
        <omgdc:Bounds x="480" y="195" width="36" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_2_di" bpmnElement="Task_2_2">
        <omgdc:Bounds x="560" y="190" width="150" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_3_di" bpmnElement="Task_2_3">
        <omgdc:Bounds x="750" y="190" width="150" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObject_3_di" bpmnElement="DataObject_3">
        <omgdc:Bounds x="920" y="195" width="36" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Signal_di" bpmnElement="Event_Signal">
        <omgdc:Bounds x="725" y="277" width="30" height="30"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DataObject_4_di" bpmnElement="DataObject_4">
        <omgdc:Bounds x="180" y="355" width="30" height="35"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_1_di" bpmnElement="Task_3_1">
        <omgdc:Bounds x="330" y="350" width="160" height="55"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_2_di" bpmnElement="Task_3_2">
        <omgdc:Bounds x="560" y="350" width="150" height="55"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_3_di" bpmnElement="Task_3_3">
        <omgdc:Bounds x="780" y="350" width="160" height="55"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true">
        <omgdc:Bounds x="1035" y="352" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_1_di" bpmnElement="TextAnnotation_1">
        <omgdc:Bounds x="1150" y="360" width="200" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_4_1_di" bpmnElement="Task_4_1">
        <omgdc:Bounds x="330" y="500" width="150" height="55"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_2_di" bpmnElement="Task_4_2">
        <omgdc:Bounds x="560" y="500" width="150" height="55"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObject_5_di" bpmnElement="DataObject_5">
        <omgdc:Bounds x="620" y="600" width="36" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_3_di" bpmnElement="Task_4_3">
        <omgdc:Bounds x="790" y="500" width="160" height="55"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_4_di" bpmnElement="Task_4_4">
        <omgdc:Bounds x="1020" y="500" width="160" height="55"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_2_di" bpmnElement="Start_2">
        <omgdc:Bounds x="162" y="682" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_1_di" bpmnElement="Task_5_1">
        <omgdc:Bounds x="330" y="675" width="150" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObject_6_di" bpmnElement="DataObject_6">
        <omgdc:Bounds x="480" y="680" width="30" height="35"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_2_di" bpmnElement="Task_5_2">
        <omgdc:Bounds x="560" y="675" width="150" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_3_di" bpmnElement="Task_5_3">
        <omgdc:Bounds x="790" y="675" width="150" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObject_7_di" bpmnElement="DataObject_7">
        <omgdc:Bounds x="950" y="680" width="30" height="35"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_4_di" bpmnElement="Task_5_4">
        <omgdc:Bounds x="1020" y="675" width="150" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObject_8_di" bpmnElement="DataObject_8">
        <omgdc:Bounds x="1180" y="680" width="30" height="35"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_5_di" bpmnElement="Task_5_5">
        <omgdc:Bounds x="1250" y="675" width="120" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1">
        <omgdc:Bounds x="1356" y="684" width="32" height="32"/>
      </bpmndi:BPMNShape>

      <!-- EDGES -->
      <bpmndi:BPMNEdge id="sf1_di" bpmnElement="sf1"><omgdi:waypoint x="168" y="80"/><omgdi:waypoint x="210" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf2_di" bpmnElement="sf2"><omgdi:waypoint x="340" y="80"/><omgdi:waypoint x="380" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf3_di" bpmnElement="sf3"><omgdi:waypoint x="510" y="80"/><omgdi:waypoint x="550" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf4_di" bpmnElement="sf4"><omgdi:waypoint x="625" y="105"/><omgdi:waypoint x="625" y="150"/><omgdi:waypoint x="405" y="150"/><omgdi:waypoint x="405" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf5_di" bpmnElement="sf5"><omgdi:waypoint x="480" y="215"/><omgdi:waypoint x="560" y="215"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf6_di" bpmnElement="sf6"><omgdi:waypoint x="710" y="215"/><omgdi:waypoint x="750" y="215"/></bpmndi:BPMNEdge>

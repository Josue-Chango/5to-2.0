<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_EstudioCaso"
                   targetNamespace="http://bizagi.com/estudiocaso">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_EstudioCaso" name="Estudio de Caso en Ingeniería de Software" processRef="Proceso_EstudioCaso" />
  </bpmn:collaboration>
<bpmn:process id="Proceso_EstudioCaso" name="Estudio de Caso en Ingeniería de Software" isExecutable="false">
  <bpmn:laneSet id="LaneSet_1">
    <bpmn:lane id="lane_pi" name="Investigador Principal">
      <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_objetivo</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_pregunta</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_seleccaso</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_metodos</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_protocolo</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>gw_aprobado</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_analisis</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>gw_validado</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_redactar</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_revision</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_retro</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_publicar</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="lane_eq" name="Equipo de Investigación">
      <bpmn:flowNodeRef>t_procedcampo</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_instrumentos</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_consentimiento</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_piloto</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_entrevistas</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_observacion</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_artefactos</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>gw_suficiente</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_registrar</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_codificar</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_cadena</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="lane_in" name="Informantes / Org. del Caso">
      <bpmn:flowNodeRef>t_informante</bpmn:flowNodeRef>
    </bpmn:lane>
  </bpmn:laneSet>
  <bpmn:startEvent id="start1" name="Inicio del Estudio de Caso">
    <bpmn:outgoing>Flow_1</bpmn:outgoing>
  </bpmn:startEvent>
  <bpmn:task id="t_objetivo" name="Definir objetivo del estudio">
    <bpmn:incoming>Flow_1</bpmn:incoming>
    <bpmn:outgoing>Flow_2</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_pregunta" name="Definir pregunta de investigación">
    <bpmn:incoming>Flow_2</bpmn:incoming>
    <bpmn:outgoing>Flow_3</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_seleccaso" name="Seleccionar el/los caso(s) específico(s)">
    <bpmn:incoming>Flow_3</bpmn:incoming>
    <bpmn:outgoing>Flow_4</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_metodos" name="Definir métodos de recolección">
    <bpmn:incoming>Flow_4</bpmn:incoming>
    <bpmn:outgoing>Flow_5</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_protocolo" name="Diseñar protocolo de investigación">
    <bpmn:incoming>Flow_5</bpmn:incoming>
    <bpmn:outgoing>Flow_6</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_procedcampo" name="Definir procedimientos de campo">
    <bpmn:incoming>Flow_6</bpmn:incoming>
    <bpmn:outgoing>Flow_7</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_instrumentos" name="Preparar instrumentos de recolección">
    <bpmn:incoming>Flow_7</bpmn:incoming>
    <bpmn:incoming>Flow_12</bpmn:incoming>
    <bpmn:outgoing>Flow_8</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_consentimiento" name="Obtener consentimiento informado">
    <bpmn:incoming>Flow_8</bpmn:incoming>
    <bpmn:outgoing>Flow_9</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_piloto" name="Realizar estudio piloto">
    <bpmn:incoming>Flow_9</bpmn:incoming>
    <bpmn:outgoing>Flow_10</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="gw_aprobado" name="¿Protocolo aprobado tras piloto?">
    <bpmn:incoming>Flow_10</bpmn:incoming>
    <bpmn:outgoing>Flow_11</bpmn:outgoing>
    <bpmn:outgoing>Flow_12</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="t_entrevistas" name="Realizar entrevistas semiestructuradas">
    <bpmn:incoming>Flow_11</bpmn:incoming>
    <bpmn:incoming>Flow_17</bpmn:incoming>
    <bpmn:incoming>Flow_23</bpmn:incoming>
    <bpmn:outgoing>Flow_13</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_observacion" name="Realizar observación directa con registros">
    <bpmn:incoming>Flow_13</bpmn:incoming>
    <bpmn:outgoing>Flow_14</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_artefactos" name="Recolectar artefactos y documentos">
    <bpmn:incoming>Flow_14</bpmn:incoming>
    <bpmn:outgoing>Flow_15</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="gw_suficiente" name="¿Información suficiente para el caso?">
    <bpmn:incoming>Flow_15</bpmn:incoming>
    <bpmn:outgoing>Flow_16</bpmn:outgoing>
    <bpmn:outgoing>Flow_17</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="t_registrar" name="Registrar y organizar datos recolectados">
    <bpmn:incoming>Flow_16</bpmn:incoming>
    <bpmn:outgoing>Flow_18</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_codificar" name="Codificación de datos cualitativos">
    <bpmn:incoming>Flow_18</bpmn:incoming>
    <bpmn:outgoing>Flow_19</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_cadena" name="Construcción de cadena de evidencia">
    <bpmn:incoming>Flow_19</bpmn:incoming>
    <bpmn:outgoing>Flow_20</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_analisis" name="Análisis dentro/entre del caso(s)">
    <bpmn:incoming>Flow_20</bpmn:incoming>
    <bpmn:outgoing>Flow_21</bpmn:outgoing>
  </bpmn:task>
  <bpmn:exclusiveGateway id="gw_validado" name="¿Hallazgos validados satisfactoriamente?">
    <bpmn:incoming>Flow_21</bpmn:incoming>
    <bpmn:outgoing>Flow_22</bpmn:outgoing>
    <bpmn:outgoing>Flow_23</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:task id="t_redactar" name="Redactar informe del caso">
    <bpmn:incoming>Flow_22</bpmn:incoming>
    <bpmn:outgoing>Flow_24</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_revision" name="Revisión por pares académicos">
    <bpmn:incoming>Flow_24</bpmn:incoming>
    <bpmn:outgoing>Flow_25</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_retro" name="Incorporar retroalimentación">
    <bpmn:incoming>Flow_25</bpmn:incoming>
    <bpmn:outgoing>Flow_26</bpmn:outgoing>
  </bpmn:task>
  <bpmn:task id="t_publicar" name="Publicar y diseminar resultados">
    <bpmn:incoming>Flow_26</bpmn:incoming>
    <bpmn:outgoing>Flow_27</bpmn:outgoing>
  </bpmn:task>
  <bpmn:endEvent id="end1" name="Fin del Estudio de Caso">
    <bpmn:incoming>Flow_27</bpmn:incoming>
  </bpmn:endEvent>
  <bpmn:task id="t_informante" name="Participar en entrevistas/observación,
otorgar consentimiento y aportar
documentos/artefactos">

  </bpmn:task>
  <bpmn:dataObjectReference id="d_protocolo" name="Protocolo de Investigación" dataObjectRef="d_protocolo_do" />
  <bpmn:dataObject id="d_protocolo_do" />
  <bpmn:dataObjectReference id="d_guia" name="Guía de Entrevista" dataObjectRef="d_guia_do" />
  <bpmn:dataObject id="d_guia_do" />
  <bpmn:dataObjectReference id="d_consent" name="Formulario de Consentimiento" dataObjectRef="d_consent_do" />
  <bpmn:dataObject id="d_consent_do" />
  <bpmn:dataObjectReference id="d_auditoria" name="Registro de Auditoría (Audit Trail)" dataObjectRef="d_auditoria_do" />
  <bpmn:dataObject id="d_auditoria_do" />
  <bpmn:dataStoreReference id="d_almacen" name="Almacén de datos" />
  <bpmn:dataObjectReference id="d_codebook" name="Esquema de Codificación (Codebook)" dataObjectRef="d_codebook_do" />
  <bpmn:dataObject id="d_codebook_do" />
  <bpmn:dataObjectReference id="d_cadenaesq" name="Esquema de cadena" dataObjectRef="d_cadenaesq_do" />
  <bpmn:dataObject id="d_cadenaesq_do" />
  <bpmn:dataObjectReference id="d_informe" name="Informe Final del Estudio" dataObjectRef="d_informe_do" />
  <bpmn:dataObject id="d_informe_do" />
  <bpmn:sequenceFlow id="Flow_1" sourceRef="start1" targetRef="t_objetivo" />
  <bpmn:sequenceFlow id="Flow_2" sourceRef="t_objetivo" targetRef="t_pregunta" />
  <bpmn:sequenceFlow id="Flow_3" sourceRef="t_pregunta" targetRef="t_seleccaso" />
  <bpmn:sequenceFlow id="Flow_4" sourceRef="t_seleccaso" targetRef="t_metodos" />
  <bpmn:sequenceFlow id="Flow_5" sourceRef="t_metodos" targetRef="t_protocolo" />
  <bpmn:sequenceFlow id="Flow_6" sourceRef="t_protocolo" targetRef="t_procedcampo" />
  <bpmn:sequenceFlow id="Flow_7" sourceRef="t_procedcampo" targetRef="t_instrumentos" />
  <bpmn:sequenceFlow id="Flow_8" sourceRef="t_instrumentos" targetRef="t_consentimiento" />
  <bpmn:sequenceFlow id="Flow_9" sourceRef="t_consentimiento" targetRef="t_piloto" />
  <bpmn:sequenceFlow id="Flow_10" sourceRef="t_piloto" targetRef="gw_aprobado" />
  <bpmn:sequenceFlow id="Flow_11" name="Sí, protocolo aprobado" sourceRef="gw_aprobado" targetRef="t_entrevistas" />
  <bpmn:sequenceFlow id="Flow_12" name="No, revisar instrumentos" sourceRef="gw_aprobado" targetRef="t_instrumentos" />
  <bpmn:sequenceFlow id="Flow_13" sourceRef="t_entrevistas" targetRef="t_observacion" />
  <bpmn:sequenceFlow id="Flow_14" sourceRef="t_observacion" targetRef="t_artefactos" />
  <bpmn:sequenceFlow id="Flow_15" sourceRef="t_artefactos" targetRef="gw_suficiente" />
  <bpmn:sequenceFlow id="Flow_16" name="Sí, información suficiente" sourceRef="gw_suficiente" targetRef="t_registrar" />
  <bpmn:sequenceFlow id="Flow_17" name="No, continuar recolección" sourceRef="gw_suficiente" targetRef="t_entrevistas" />
  <bpmn:sequenceFlow id="Flow_18" sourceRef="t_registrar" targetRef="t_codificar" />
  <bpmn:sequenceFlow id="Flow_19" sourceRef="t_codificar" targetRef="t_cadena" />
  <bpmn:sequenceFlow id="Flow_20" sourceRef="t_cadena" targetRef="t_analisis" />
  <bpmn:sequenceFlow id="Flow_21" sourceRef="t_analisis" targetRef="gw_validado" />
  <bpmn:sequenceFlow id="Flow_22" name="Sí, hallazgos validados" sourceRef="gw_validado" targetRef="t_redactar" />
  <bpmn:sequenceFlow id="Flow_23" name="No, recolectar más datos (volver a Fase 3)" sourceRef="gw_validado" targetRef="t_entrevistas" />
  <bpmn:sequenceFlow id="Flow_24" sourceRef="t_redactar" targetRef="t_revision" />
  <bpmn:sequenceFlow id="Flow_25" sourceRef="t_revision" targetRef="t_retro" />
  <bpmn:sequenceFlow id="Flow_26" sourceRef="t_retro" targetRef="t_publicar" />
  <bpmn:sequenceFlow id="Flow_27" sourceRef="t_publicar" targetRef="end1" />
  <bpmn:association id="Assoc_1" sourceRef="t_protocolo" targetRef="d_protocolo" />
  <bpmn:association id="Assoc_2" sourceRef="t_instrumentos" targetRef="d_guia" />
  <bpmn:association id="Assoc_3" sourceRef="t_consentimiento" targetRef="d_consent" />
  <bpmn:association id="Assoc_4" sourceRef="t_registrar" targetRef="d_auditoria" />
  <bpmn:association id="Assoc_5" sourceRef="t_registrar" targetRef="d_almacen" />
  <bpmn:association id="Assoc_6" sourceRef="t_codificar" targetRef="d_codebook" />
  <bpmn:association id="Assoc_7" sourceRef="t_cadena" targetRef="d_cadenaesq" />
  <bpmn:association id="Assoc_8" sourceRef="t_redactar" targetRef="d_informe" />
  <bpmn:association id="Assoc_9" sourceRef="t_informante" targetRef="t_consentimiento" />
  <bpmn:association id="Assoc_10" sourceRef="t_informante" targetRef="t_entrevistas" />
  <bpmn:association id="Assoc_11" sourceRef="t_informante" targetRef="t_observacion" />
  <bpmn:association id="Assoc_12" sourceRef="t_informante" targetRef="t_artefactos" />
</bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Pool_EstudioCaso">
